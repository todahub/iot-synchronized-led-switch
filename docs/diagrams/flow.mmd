flowchart TD
  subgraph S1 [クライアント送信側]
    direction LR
    A1["クライアント：現在時刻取得"] --> A2["コマンド作成：ID=0x01、タイムスタンプ、LED状態"] --> A3["CRC計算"] --> A4["サーバーへ送信"]
  end

  subgraph S2 [サーバー側]
    direction LR
    B1["サーバー：8バイト受信"] --> B2["CRC検算"] --> B3["コマンドID確認（0x01か）"] --> B4["LED状態取得・次の切替時刻決定"] --> B5["コマンド作成：ID=0x02、タイムスタンプ、LED状態"] --> B6["CRC計算"] --> B7["クライアントへ送信"]
  end

  subgraph S3 [クライアント受信側]
    direction LR
    C1["クライアント：8バイト受信"] --> C2["CRC検算"] --> C3["コマンドパース"] --> C4["指定時刻でLED制御"]
  end

  %% サブグラフ同士は縦に並べたいので、S1 -> S2 -> S3 と繋ぐ
  S1 --> S2 --> S3




