int count = 0;

void setup() {
  // put your setup code here, to run once:
  matrix.begin();
}

void loop() {
  if(count > NUMBER)
    count = 0;
  drowPattern(count);
  matrix.renderBitmap(frame, 8, 12);
  delay(100);
  count++;
  
  // put your main code here, to run repeatedly:

}

void drowPattern(int count){
  for(int i = 0; i < 8;i++)
    for(int j = 0; j < 12;j++){
      int ylin = j + count;
      if(ylin <NUMBER)
      frame[i][j] = pattern[i][ylin];
      else{
        ylin-=NUMBER;
       frame[i][j] = pattern[i][ylin];
      }
    }
}
